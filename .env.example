# Application Settings
APP_NAME="Cloudinary-Clone Image Processing API"
APP_ENV=development
DEBUG=true

# PostgreSQL Database
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=image_service
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/image_service
SYNC_DATABASE_URL=postgresql+psycopg2://your_postgres_user:your_postgres_password@localhost:5432/image_service

# JWT Authentication (Access + Refresh Token)
JWT_SECRET_KEY=replace_with_32_byte_random_hex_access_secret
JWT_REFRESH_SECRET_KEY=replace_with_32_byte_random_hex_refresh_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO / S3 / Cloudflare R2 Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=your_s3_or_minio_access_key
S3_SECRET_KEY=your_s3_or_minio_secret_key
S3_BUCKET_NAME=images
S3_REGION=us-east-1

# Redis (Cache, Rate Limit & Celery Result Backend)
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# RabbitMQ (Celery Message Broker)
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
CELERY_BROKER_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@localhost:5672//

# Rate Limiting & Caching
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_TRANSFORM_PER_MINUTE=10
CACHE_TTL_SECONDS=3600
MAX_UPLOAD_SIZE_MB=15
